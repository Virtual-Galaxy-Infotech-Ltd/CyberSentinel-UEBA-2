# ─────────────────────────────────────────────────────────────────────────────
# UEBA deployment answers — vgipl / 10.200.10.23  (the SIEM host)
#
#   sudo ./install_ueba.sh --unattended deploy/vgipl.answers.env
#
# Every value here came from the preflight survey of this host, not from an
# assumption. Read it before running: this file IS the deployment.
# ─────────────────────────────────────────────────────────────────────────────

CLIENT_NAME="Virtual Galaxy Infotech"

# ── Topology ────────────────────────────────────────────────────────────────
# 1 = UEBA runs ON the SIEM host. No sync bridge, no SSH, no second copy of
# the data: the engine consumes the correlation pipeline's Kafka topic.
CO_LOCATED=1

# 39092, NOT 9092. The pipeline's own layers connect on 39092; 9092 is only
# reachable inside the broker container. Taken from the launch line in
# pipeline.log.
KAFKA_BROKERS="localhost:39092"
KAFKA_TOPIC="enriched"

# ── Install location ────────────────────────────────────────────────────────
# A directory of its own that nothing else on this host uses.
BASE_DIR="/opt/ueba"
DATA_DIR="/opt/ueba/data"

# ── Dashboard ───────────────────────────────────────────────────────────────
# LOOPBACK ONLY. 29 other services already run here, several publicly bound;
# UEBA should not add another public listener unless someone decides to.
# Reach it with:  ssh -L 3026:127.0.0.1:3026 root@10.200.10.23
DASH_HOST="127.0.0.1"
DASH_PORT="3026"

# ── Resource caps — the "don't disturb anything" guarantee ──────────────────
# This host has 125 GB RAM with ~101 GB used, ~24 GB available, and swap 100%
# consumed. The kernel OOM killer picks the LARGEST process, not the guilty
# one, so an uncapped UEBA would take out whatever is biggest here: a 35 GB
# Java heap, ClickHouse, or Elasticsearch.
#
# With these caps, if UEBA misbehaves then UEBA dies and nothing else notices.
# Set well under both the ~24 GB available and the 19.5 GB the engine used on
# the old host, so this starts conservative and is raised only if its own logs
# show it needs more.
MEM_ENGINE="10G"
MEM_DASHBOARD="3G"

# This server's own IP, suppressed as an alert source. Without it UEBA's own
# traffic scores as anomalies against the estate it is watching.
SELF_IP="10.200.10.23"

# ── Reference paths (not used for ingestion in co-located mode) ─────────────
SIEM_ENRICHED_DIR="/home/vgipl/CyberSentinel-Event-Correlation-Kafka/data/enriched"
SIEM_CLIENT_KEYS="/var/ossec/etc/client.keys"
