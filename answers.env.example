# ─────────────────────────────────────────────────────────────────────────────
#  CyberSentinel UEBA — unattended install answers
# ─────────────────────────────────────────────────────────────────────────────
#
#  Copy per customer, fill in, then:
#      sudo ./install_ueba.sh --unattended /path/to/thisfile.env
#
#  Every value here is also asked interactively if you run the installer with no
#  arguments. Use this form for repeatable rollouts across several banks.
#
#  Before running unattended, the installer's SSH key must ALREADY be authorised
#  on the SIEM — unattended mode will not prompt for a password. Generate it with
#  an interactive run, or:
#      ssh-keygen -t ed25519 -N "" -f /root/.ssh/id_ueba
#      ssh-copy-id -i /root/.ssh/id_ueba.pub -p <port> <user>@<siem-host>

# ── Who this deployment is for ───────────────────────────────────────────────
CLIENT_NAME="Example Bank Ltd"

# ── The SIEM this UEBA instance reads from ───────────────────────────────────
# The CyberSentinel SIEM / Wazuh manager. UEBA pulls enriched logs and the agent
# registry from here over SSH.
SIEM_HOST="10.0.0.23"
SIEM_PORT="22"
SIEM_USER="root"

# Where the correlation service writes enriched events on the SIEM.
SIEM_ENRICHED_DIR="/home/root/CyberSentinel-Event-Correlation-Kafka/data/enriched"

# Wazuh's agent registry — this is what gives endpoints their real names on the
# dashboard instead of bare IPs.
SIEM_CLIENT_KEYS="/var/ossec/etc/client.keys"

# ── This UEBA server ─────────────────────────────────────────────────────────
BASE_DIR="/opt/cybersentinel/ueba"

# Needs roughly 500 GB to start and grows ~65 GB/month, almost all of it the
# append-only training corpus. Put it on NVMe: a retrain is disk-I/O bound, not
# CPU bound, so disk speed sets whether it takes ~1 hour or ~11.
DATA_DIR="/data/ueba"

DASH_HOST="0.0.0.0"
DASH_PORT="3026"

# This server's own IP. It is added to noise_suppression.suppress_source_ips so
# UEBA's own sync/SSH traffic does not score as alerts against the estate it is
# watching. Leave blank to auto-detect from the default route.
SELF_IP=""
