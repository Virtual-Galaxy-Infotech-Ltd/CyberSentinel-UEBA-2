# ─────────────────────────────────────────────────────────────────────────────
#  CyberSentinel UEBA — unattended install answers
# ─────────────────────────────────────────────────────────────────────────────
#
#  Copy per customer, fill in, then:
#      ./check_dependencies.sh --dir /opt/cybersentinel/ueba        # stage 1
#      sudo ./install_ueba.sh --unattended /path/to/thisfile.env    # stage 2
#
#  Stage 1 changes nothing and can be run days earlier, by the customer's own
#  platform team, against the prerequisite list in the change record.
#
#  Every value here is also asked interactively if you run the installer with no
#  arguments. Use this form for repeatable rollouts across several banks.
#
#  Before running unattended, the installer's SSH key must ALREADY be authorised
#  on the SIEM — unattended mode will not prompt for a password. Generate it with
#  an interactive run, or:
#      ssh-keygen -t ed25519 -N "" -f /root/.ssh/id_ueba
#      ssh-copy-id -i /root/.ssh/id_ueba.pub -p <port> <user>@<siem-host>

# ── Who this deployment is for ───────────────────────────────────────────────
CLIENT_NAME="Example Bank Ltd"

# ── The SIEM this UEBA instance reads from ───────────────────────────────────
# The CyberSentinel SIEM manager. UEBA pulls enriched logs and the agent
# registry from here over SSH.
SIEM_HOST="10.0.0.23"
SIEM_PORT="22"
SIEM_USER="root"

# Where the correlation service writes enriched events on the SIEM.
SIEM_ENRICHED_DIR="/home/root/CyberSentinel-Event-Correlation-Kafka/data/enriched"

# The SIEM's agent registry — this is what gives endpoints their real names on the
# dashboard instead of bare IPs.
SIEM_CLIENT_KEYS="/var/ossec/etc/client.keys"

# ── This UEBA server ─────────────────────────────────────────────────────────
BASE_DIR="/opt/cybersentinel/ueba"

# Needs roughly 500 GB to start and grows ~65 GB/month, almost all of it the
# append-only training corpus. Put it on NVMe: a retrain is disk-I/O bound, not
# CPU bound, so disk speed sets whether it takes ~1 hour or ~11.
DATA_DIR="/data/ueba"

# The address this UEBA instance is reached at: the console URL, the alert
# suppression entry, and the endpoint the SIEM dials in reverse-tunnel mode.
# Leave blank to auto-detect from the default route.
UEBA_HOST=""

# Bind address. 0.0.0.0 serves the console on every interface; 127.0.0.1 serves
# it on the loopback only, reachable through an SSH port-forward. Leave blank
# and it is derived from UEBA_HOST.
DASH_HOST="0.0.0.0"
DASH_PORT="3026"

# This server's own IP. Added to noise_suppression.suppress_source_ips so
# UEBA's own sync/SSH traffic does not score as alerts against the estate it is
# watching. Leave blank and UEBA_HOST is used.
SELF_IP=""

# ── Topology ─────────────────────────────────────────────────────────────────
# Normally LEAVE THIS UNSET. The installer works it out by comparing SIEM_HOST
# against the addresses this host actually holds, which is the one answer that
# cannot be got wrong by typing. Set it only to override that — and if it
# disagrees with the addresses, the installer says so before it proceeds.
#   1 = UEBA runs on the SIEM host itself; the engine consumes the enriched
#       Kafka topic directly, and there is no bridge and no second copy of data.
#   0 = separate hosts; the feed crosses the network.
# CO_LOCATED=0

# Co-located installs only: the broker the SIEM pipeline publishes to. The
# consumer group is always ueba-engine and is not configurable — reusing one of
# the pipeline's own groups would take partitions away from that consumer and
# the SIEM's file sink would quietly stop seeing a share of events.
# KAFKA_BROKERS="localhost:39092"
# KAFKA_TOPIC="enriched"

# ── Bridge transport (separate hosts only) ───────────────────────────────────
# Which direction the feed is allowed to cross in. Unset means the installer
# probes the direct path and asks; under --unattended, set it explicitly.
#   direct  — UEBA dials the SIEM. Needs outbound UEBA → SIEM:SIEM_PORT.
#   reverse — the SIEM dials UEBA and publishes its own SSH port on UEBA's
#             loopback. For a SIEM segment that accepts no inbound connections.
#             The installer then writes a handover bundle (key, systemd unit,
#             firewall request) for whoever owns the SIEM host.
# BRIDGE_MODE_PRESET="direct"

# Reverse mode only.
# TUNNEL_SSHD_PORT="9022"      # the port on THIS host the SIEM connects to
# TUNNEL_LOCAL_PORT="2222"     # where the SIEM's SSH appears on this loopback
# TUNNEL_USER="ueba-tunnel"    # restricted, no shell, forwarding only

# ── Offline sites ────────────────────────────────────────────────────────────
# A bank host usually cannot reach pypi.org. Stage the wheels on a connected
# machine with
#     pip download -r requirements.txt -d ueba-wheels
# and point stage 1 at them; it then fails if any declared package is absent.
# WHEELHOUSE="/mnt/usb/ueba-wheels"
